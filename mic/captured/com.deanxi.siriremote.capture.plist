<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.deanxi.siriremote.capture</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/SiriRemote/SiriRemoteCapture</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>MachServices</key>
    <dict>
        <key>com.deanxi.siriremote.capture</key>
        <true/>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Adaptive</string>
    <key>StandardOutPath</key>
    <string>/Library/Logs/SiriRemote/capture.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/SiriRemote/capture.log</string>
</dict>
</plist>
